{
  "name": "argentum-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Tauri desktop client for Argentum Engine (https://magic.wingedsheep.com)",
  "scripts": {
    "prepare:web": "bash scripts/prepare.sh",
    "dev:web": "cd vendor/argentum-engine/web-client && VITE_BACKEND_URL=$BACKEND_URL bunx --bun vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "cd vendor/argentum-engine/web-client && VITE_BACKEND_URL=$BACKEND_URL bunx --bun vite build",
    "dev": "BACKEND_URL=${BACKEND_URL:-https://magic.wingedsheep.com} tauri dev",
    "build": "BACKEND_URL=${BACKEND_URL:-https://magic.wingedsheep.com} tauri build",
    "tauri": "tauri",
    "ensure:web": "bash scripts/ensure-vendor.sh",
    "predev": "bun run ensure:web",
    "prebuild": "bun run ensure:web"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
